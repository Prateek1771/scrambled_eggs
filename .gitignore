# --- secrets -----------------------------------------------------------------
#
# .env holds a real OPENAI_API_KEY and the database root password. .env.example
# is the template and is meant to be committed; nothing else matching .env is.
.env
.env.*
!.env.example

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- node / next -------------------------------------------------------------
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Regenerated by `next dev` on every run. Instructions for AI tooling rather than
# part of the project, so they stay out of the repo.
AGENTS.md
CLAUDE.md

# --- test and tooling artefacts ----------------------------------------------
#
# docs/screenshots/ is deliberately NOT ignored: those images are produced by the
# tests that assert the behaviour they show, and they are part of the write-up.
playwright-report/
test-results/
.playwright/
coverage/
*.log

# --- local agent tooling -----------------------------------------------------
.claude
.agents
skills-lock.json

# --- editors and os ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
