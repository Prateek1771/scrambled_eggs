# Copy to .env and fill in OPENAI_API_KEY. Everything else has a working default.

# --- the only secret that leaves the machine ---------------------------------
OPENAI_API_KEY=sk-...

# Optional. Points the same code at any OpenAI-compatible endpoint --
# Azure OpenAI, LiteLLM, vLLM, Ollama. Leave unset for OpenAI proper.
# OPENAI_BASE_URL=http://localhost:11434/v1

# --- models -------------------------------------------------------------------
# Reasoning and fact extraction: long context, structured output, once per turn.
LLM_MODEL=gpt-5.6-terra
# Contradiction and dedupe adjudication: tiny prompts, several times per turn.
# Cheap on purpose -- by the time this model is asked "does this contradict
# that?", the graph has already narrowed the candidates to a handful of records.
LLM_MODEL_FAST=gpt-5.6-luna
EMBED_MODEL=text-embedding-3-small

# Must equal the output width of EMBED_MODEL *and* the HNSW DIMENSION declared in
# db/schema.surql. The migration asserts this and refuses to start on a mismatch,
# rather than letting it surface as a query error on the first message.
# text-embedding-3-small emits 1536 natively, so the defaults already agree.
EMBED_DIM=1536

# --- running this for free ----------------------------------------------------
# CORTEX needs chat *and* embeddings *and* structured output from ONE endpoint
# with ONE key -- there is a single OPENAI_BASE_URL, because the agent's reasoner
# and its recall tool share a provider. That rules out most "free LLM API" lists:
# Groq, Cerebras and SambaNova are chat-only or chat-first, and mixing two
# vendors means putting a LiteLLM proxy in front and pointing this at that.
#
# Google's Gemini free tier is the one that covers all three, needs no card, and
# can emit 1536-wide vectors -- so the HNSW index below stays untouched. Swap the
# four lines above for these:
#
# OPENAI_API_KEY=<from https://aistudio.google.com/apikey>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash
# LLM_MODEL_FAST=gemini-3.8-flash
# EMBED_MODEL=gemini-embedding-001
# EMBED_DIM=1536
#
# Any other endpoint is fine too, but check two things first, because both fail
# late and confusingly: the embedding model must be able to emit EMBED_DIM (the
# HNSW index cannot be widened after definition -- changing it means editing
# db/schema.surql and `make clean`), and the chat model must support tool calling,
# since the reasoner is `bind_tools(...).with_structured_output(...)` and degrades
# to a parse error rather than a worse answer without it.
#
# Entirely offline: OPENAI_BASE_URL=http://host.docker.internal:11434/v1 with any
# non-empty key, LLM_MODEL=qwen3.6:8b, EMBED_MODEL=nomic-embed-text -- but that
# one emits 768, so EMBED_DIM=768 and db/schema.surql's DIMENSION must follow.

# --- database -----------------------------------------------------------------
SURREAL_NS=cortex
SURREAL_DB=main
SURREAL_ROOT_USER=root
SURREAL_ROOT_PASS=root

# The browser's credential. A DATABASE user with the VIEWER role -- it can SELECT
# and LIVE SELECT and nothing else. The API mints short-lived tokens from it; the
# password itself never reaches the browser.
SURREAL_VIEWER_PASS=viewer

# Reachable from inside the compose network (used by the api container).
SURREAL_URL=ws://surrealdb:8000/rpc

# --- browser ------------------------------------------------------------------
# The API listens on 8000 inside the network too, so it is published on API_PORT
# to leave the database's port alone. 8080 is a busy port on developer machines
# -- change API_PORT if something already owns it, and keep NEXT_PUBLIC_API_URL
# pointing at the same number.
API_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Where the browser reaches the database. The API hands this to the browser at
# runtime via /viewer-token, so it is NOT a NEXT_PUBLIC_ variable -- those are
# inlined at build time and would pin the web image to one machine.
SURREAL_PUBLIC_URL=ws://localhost:8000/rpc

# Where the UI is published. 3000 is the documented default; change it if
# something else on your machine already owns that port.
WEB_PORT=3000

# --- first run ----------------------------------------------------------------
# Seed a demo memory so the graph is interesting on first load, replayed from
# tests/corpus.py. Set to false to start empty. `small` is ~150 entities and ~340
# facts; `medium` is ~720 and ~3,400 and takes about a minute to load.
SEED=true
SEED_SCALE=small

# No NEXT_PUBLIC_* variable carries an OpenAI or database credential. The browser
# gets a short-lived read-only SurrealDB token and nothing else. If a key ever
# appears in a NEXT_PUBLIC_ variable in a diff, that is the bug.
