# Copy to .env and fill in OPENAI_API_KEY. Everything else has a working default.

# --- the only secret that leaves the machine ---------------------------------
OPENAI_API_KEY=sk-...

# Optional. Points the same code at any OpenAI-compatible endpoint --
# Azure OpenAI, LiteLLM, vLLM, Ollama. Leave unset for OpenAI proper.
# OPENAI_BASE_URL=http://localhost:11434/v1

# --- models -------------------------------------------------------------------
# Reasoning and fact extraction: long context, structured output, once per turn.
LLM_MODEL=gpt-5.6-terra
# Contradiction and dedupe adjudication: tiny prompts, several times per turn.
# Cheap on purpose -- by the time this model is asked "does this contradict
# that?", the graph has already narrowed the candidates to a handful of records.
LLM_MODEL_FAST=gpt-5.6-luna
EMBED_MODEL=text-embedding-3-small

# Must equal the output width of EMBED_MODEL *and* the HNSW DIMENSION declared in
# db/schema.surql. The migration asserts this and refuses to start on a mismatch,
# rather than letting it surface as a query error on the first message.
# text-embedding-3-small emits 1536 natively, so the defaults already agree.
EMBED_DIM=1536

# --- database -----------------------------------------------------------------
SURREAL_NS=cortex
SURREAL_DB=main
SURREAL_ROOT_USER=root
SURREAL_ROOT_PASS=root

# The browser's credential. A DATABASE user with the VIEWER role -- it can SELECT
# and LIVE SELECT and nothing else. The API mints short-lived tokens from it; the
# password itself never reaches the browser.
SURREAL_VIEWER_PASS=viewer

# Reachable from inside the compose network (used by the api container).
SURREAL_URL=ws://surrealdb:8000/rpc

# --- browser ------------------------------------------------------------------
# Reachable from the user's browser, not from inside the network.
NEXT_PUBLIC_SURREAL_URL=ws://localhost:8000/rpc
# The API listens on 8000 inside the network too, so it is published on 8080 to
# leave the database's port alone.
NEXT_PUBLIC_API_URL=http://localhost:8080

# No NEXT_PUBLIC_* variable carries an OpenAI or database credential. The browser
# gets a short-lived read-only SurrealDB token and nothing else. If a key ever
# appears in a NEXT_PUBLIC_ variable in a diff, that is the bug.
